# environments, caches, build products
.venv/
__pycache__/
*.pyc
.DS_Store
*.so
*.dylib
*.dSYM/
*.tmp
*.part
*.lock
.pytest_cache/
.claude/

# run logs (the two that scripts/summarize.py reads are kept next to their records in results/)
/logs/

# third-party material: not redistributed here, see "External data" in README.md
papers/downloads/
papers/amplified/repo/
papers/mitten/mitten/
papers/mitten/structured_mitten/
papers/mitten/abelian_poly_LP/
papers/mitten/README.md
papers/new/*_fulltext.txt
bench/external/

# generated on demand
circuits/papers/
bench/instances/*/*
!bench/instances/*/meta.json
bench/instances_wjh/*/*
!bench/instances_wjh/*/meta.json
bench/instances_lowwidth/*/*
!bench/instances_lowwidth/*/meta.json
papers/downloads/codedistance_codes.json

# scratch and development runs
results/bench_dev/
results/bench_scratch/
results/bench_shakeout/
results/papers4/hypsurf/*.stim
# large tiling lists that no reported result uses (regenerate with papers/hyperbolic_lins.g)
results/papers4/hyperbolic/lins_444_4096.jsonl
results/papers4/hyperbolic/lins_666_2184.jsonl
# stale outputs of an early partial report
results/bench/BENCHMARK_partial.md
results/bench/summary.csv
results/bench/profile.csv
# reading note with long verbatim quotations from the paper; kept locally
papers/new/2608.02773.md
# harness logs and markers of the low-width trial; the records are the .json files
results/bench_lowwidth*/*/*.log
results/bench_lowwidth*/*.lock
results/bench_lowwidth*/*.done
# exported matrices and circuits of the planar-code study (regenerate with scripts/planar_dp.py export and
# papers/planar_vine.py export_circuits; the vine circuits are built from the authors' Zenodo files); meta.json is kept
results/planar_dp/instances/*/*
!results/planar_dp/instances/*/meta.json
results/planar_dp/circuits/*/*
!results/planar_dp/circuits/*/meta.json
results/planar_dp/**/*.log
